# SentinelX Core — Environment Configuration
APP_NAME=SentinelXCore
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
WS_PORT=8766

# Paths (relative to project root)
DATA_DIR=data
CONFIG_DIR=config
LOG_DIR=logs
BLOCKLIST_DIR=data/blocklists
MODELS_DIR=data/models

# VPN / AdBlock
VPN_ENABLED=false
BLOCKLIST_UPDATE_INTERVAL_HOURS=24

# AI
ANOMALY_THRESHOLD=0.65
AI_ENABLED=true
